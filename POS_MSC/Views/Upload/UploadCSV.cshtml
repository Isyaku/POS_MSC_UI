@model UploadViewModel

@{
    ViewData["Title"] = "Home";
}


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var modelState in ViewData.ModelState.Values)
            {
                foreach (var error in modelState.Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            }
        </ul>
    </div>
}

<div class="container mt-4 d-flex justify-content-center">
    <form asp-action="UploadCSV" method="post" enctype="multipart/form-data" style="width: 100%; max-width: 600px;">
        <div class="card">
            <div class="card-header text-center">
                <h4 class="card-title mb-0">Upload CSV</h4>
            </div>
            <div class="card-body text-center">               
                <input asp-for="ExcelFile" type="file" class="form-control mb-4" />
                <button id="submitBtn" type="submit" class="btn btn-success w-100">
                    <span id="btnText">Submit</span>
                    <span id="btnSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
                </button>
                @* <button type="submit" class="btn btn-success w-100">Submit</button> *@
            </div>
        </div>
    </form>
</div>


<div id="loadingOverlay" class="d-none position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex justify-content-center align-items-center" style="z-index:1050;">
    <div class="text-center text-white">
        <div class="spinner-border" role="status"></div>
        <div class="mt-3">Uploading, please wait...</div>
    </div>
</div>

@if (Model.UploadModel != null && Model.UploadModel.Any())
{
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">Upload List</h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-primary table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Upload Date</th>
                                    <th>Credit Account</th>
                                    <th>View</th>
                                    <th>Approval</th>
                                    <th>Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.UploadModel)
                                {
                                    <tr>
                                        <td>@item.UploadDate</td>
                                        <td>@item.CreditAccount</td>
                                        <td>
                                            <a class="btn btn-info btn-sm" asp-controller="Upload" asp-action="ViewList" asp-route-uploadID="@item.ID">View</a>

                                        </td>
                                        <td>
                                            <a class="btn btn-success btn-sm" asp-controller="Upload" asp-action="RequestApproval" asp-route-uploadID="@item.ID">Request Approval</a>
                                        </td>
                                        <td>
                                            <a class="btn btn-danger btn-sm" asp-controller="Upload" asp-action="DeleteUpload" asp-route-uploadID="@item.ID">Delete</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


<script>
    document.querySelector("form").addEventListener("submit", function () {

        var btn = document.getElementById("submitBtn");
        var spinner = document.getElementById("btnSpinner");
        var text = document.getElementById("btnText");

        // Disable button
        btn.disabled = true;

        // Show spinner
        spinner.classList.remove("d-none");

        // Change text
        text.textContent = "Uploading...";
    });
</script>