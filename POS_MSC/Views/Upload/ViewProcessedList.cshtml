@model ViewListModel

@{
    ViewData["Title"] = "Record List";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <a class="btn btn-danger btn-sm" asp-controller="Upload" asp-action="UploadList">Back</a>
            </div>
        </div>
    </div>
</div>


@if (Model.Settlements != null && Model.Settlements.Any())
{
    int serialNumber = 1;

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">Record List</h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-primary table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>SN</th>
                                    <th>Status</th>
                                    <th>BranchCode</th>
                                    <th>Debit Account</th>
                                    <th>Credit Account</th>
                                    <th>CVAmount</th>
                                    <th>ValueDate</th>
                                    <th>Description</th>
                                    <th>Transaction ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Settlements)
                                {
                                    <tr>
                                        <td>@serialNumber</td>
                                        <td>@(item.Status == "10" ? "Successful" : "Failed")</td>
                                        <td>@item.BranchCode</td>
                                        <td>@item.DebitAcct</td>
                                        <td>@item.CreditAcct</td>
                                        <td>@item.CVAmount</td>
                                        <td>@item.ValueDate</td>
                                        <td>@item.Description</td>
                                        <td>@item.TransactionId</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-body text-center">
                    <span class="fw-bold d-block">Count: @Model.Count</span>
                    <span id="amount" class="fw-bold d-block">Sum: @Model.Sum</span>
                </div>
                <button onclick="scrollToTop()" class="btn btn-primary position-fixed bottom-0 end-0 m-4" title="Back to Top">
                    ↑ Top
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <h5>No items found.</h5>
    </div>
}

<script>
    function scrollToTop() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    const amountEl = document.getElementById("amount");
    const rawText = amountEl.textContent.replace("Sum:", "").trim();
    const value = parseFloat(rawText);

    if (!isNaN(value)) {
        amountEl.textContent = "Sum: " + value.toLocaleString('en-US');
    }
</script>