@model List<UploadModel>

@{
    ViewData["Title"] = "Upload List";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <h5>@TempData["SuccessMessage"]</h5>
    </div>
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <a class="btn btn-success btn-sm" asp-controller="Upload" asp-action="ProcessedList">View Processed List</a>
                <a class="btn btn-info btn-sm" asp-controller="Upload" asp-action="ApprovedUploadList">View Approved List</a>
                <a class="btn btn-warning btn-sm" asp-controller="Upload" asp-action="RejectedUploadList">View Rejected List</a>
            </div>           
        </div>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">Upload List</h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-primary table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Upload Date</th>
                                    <th>Amount</th>
                                    <th>Credit Account</th>
                                    <th>Collection Account</th>
                                    <th>View</th>
                                    <th>Upload Progress</th>
                                    <th>Approval</th>
                                    <th>Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.UploadDate</td>
                                        <td class="amount">@item.TotalAmount</td>
                                        <td>@item.CreditAccount</td>
                                        <td>@item.TransientAccount</td>
                                        <td>
                                            <a class="btn btn-info btn-sm" asp-controller="Upload" asp-action="ViewList" asp-route-uploadID="@item.ID">View</a>

                                        </td>
                                        <td>
                                            <div class="progress">
                                                <div class="progress-bar"
                                                     role="progressbar"
                                                     style="width:@item.ProgressPercentage%">
                                                    @item.ProgressPercentage%
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <a class="btn btn-success btn-sm" asp-controller="Upload" asp-action="RequestApproval" asp-route-uploadID="@item.ID">Request Approval</a>
                                        </td>
                                        <td>
                                            <a class="btn btn-danger btn-sm" asp-controller="Upload" asp-action="DeleteUpload" asp-route-uploadID="@item.ID">Delete</a>
                                        </td>                                       
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <h5>No items found.</h5>
    </div>
}

<script>
    document.querySelectorAll(".amount").forEach(function(cell) {
        let value = parseFloat(cell.textContent);
        if (!isNaN(value)) {
            cell.textContent = value.toLocaleString('en-US');
        }
    });

    setTimeout(function () {
        location.reload();
    }, 5000);
</script>
