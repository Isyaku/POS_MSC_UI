@model List<MSC_AuditLogModel>

@{
    ViewData["Title"] = "Audit Log";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <a class="btn btn-danger btn-sm" asp-controller="Approval" asp-action="Index">Back</a>
            </div>
        </div>
    </div>
</div>


@if (Model != null && Model.Any())
{
    int serialNumber = 1;

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">Record List</h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-primary table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>SN</th>
                                    <th>Staff</th>
                                    <th>Action</th>
                                    <th>Time</th>                                   
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@serialNumber</td>
                                        <td>@item.Staff</td>
                                        <td>@item.Action</td>
                                        <td>@item.Time</td>
                                    </tr>
                                    serialNumber++;
                                }
                                
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <h5>No items found.</h5>
    </div>
}
